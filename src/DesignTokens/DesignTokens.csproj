<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>DesignTokens.Avalonia</PackageId>
    <Version>0.1.0</Version>
    <Authors>Shirasagi0012</Authors>
    <Description>A strongly-typed, dynamic design token system for Avalonia. Token values are resolved via typed resolvers and updated through observable bindings, enabling dynamic token-based theming similar to DynamicResource.</Description>
    <PackageTags>avalonia;design-tokens;theming;mvvm</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/shirasagi0012/DesignTokens</PackageProjectUrl>
    <RepositoryUrl>https://github.com/shirasagi0012/DesignTokens</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0-preview2" />
  </ItemGroup>

</Project>
